# --- Required settings even when working locally. ---

# OpenAI API Config (set OPENAI_BASE_URL for local llama.cpp OpenAI-compatible server)
OPENAI_MODEL_ID=qwen3-8b-dpo-q4km
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://127.0.0.1:8001/v1

# RAG / ml_service: use local llama.cpp instead of AWS SageMaker
USE_LOCAL_LLM_INFERENCE=true
LOCAL_LLM_MODEL_ID=qwen3-8b-dpo-q4km

# Huggingface API Config
HUGGINGFACE_ACCESS_TOKEN=str

# Comet ML (during training and inference) 
COMET_API_KEY=str

# Local QLoRA training on RTX 3090
LOCAL_TRAINING=true
TRAINING_BASE_MODEL=Qwen/Qwen3-8B
TRAINING_MAX_SEQ_LENGTH=1024
TRAINING_OUTPUT_DIR=data/training_output
LOCAL_SFT_DATASET_PATH=data/artifacts/instruct_datasets.json
LOCAL_DPO_DATASET_PATH=data/artifacts/preference_datasets.json
TRAINING_REPORT_TO=none

# --- Required settings when deploying the code. ---
# --- Otherwise, default values work fine. ---

# MongoDB database
DATABASE_HOST="mongodb://llm_engineering:llm_engineering@127.0.0.1:27017"

# Qdrant vector database
USE_QDRANT_CLOUD=false
QDRANT_CLOUD_URL=str
QDRANT_APIKEY=str

# AWS Authentication
AWS_ARN_ROLE=str
AWS_REGION=eu-central-1
AWS_ACCESS_KEY=str
AWS_SECRET_KEY=str
